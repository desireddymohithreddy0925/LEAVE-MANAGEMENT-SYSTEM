    {
      "name": "5. Leave Request",
      "item": [
        {
          "name": "Apply for Leave",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"leaveTypeId\": 1,\n  \"startDate\": \"2026-10-01\",\n  \"endDate\": \"2026-10-05\",\n  \"reason\": \"Family trip\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/leave-requests",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests"]
            }
          }
        },
        {
          "name": "Apply for Leave (Failure: Past Date)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": 1,\n  \"leaveTypeId\": 1,\n  \"startDate\": \"2023-01-01\",\n  \"endDate\": \"2023-01-05\",\n  \"reason\": \"Retroactive leave\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/leave-requests",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests"]
            }
          }
        },
        {
          "name": "Approve Leave",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "http://localhost:8080/api/leave-requests/1/approve",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests", "1", "approve"]
            }
          }
        },
        {
          "name": "Reject Leave",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "http://localhost:8080/api/leave-requests/1/reject?reason=Insufficient+staff",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests", "1", "reject"],
              "query": [
                {
                  "key": "reason",
                  "value": "Insufficient+staff"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Leave",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "http://localhost:8080/api/leave-requests/1/cancel",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests", "1", "cancel"]
            }
          }
        },
        {
          "name": "Search/Filter/Paginate Leaves",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/leave-requests?status=PENDING&page=0&size=5",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "leave-requests"],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    }
