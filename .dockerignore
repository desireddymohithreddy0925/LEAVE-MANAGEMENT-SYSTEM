# Version control and CI
.git/
.gitignore
.github/

# Build and compilation outputs
target/
target 2/
**/* 2*

# IDE and editor files
.idea/
.vscode/
*.iml

# Test suites and testing scripts
node_modules/
postman/
run-postman-tests.sh
e2e-test.sh

# Environment secrets (never bundle into images)
.env
.env.*
!.env.example
!.env.*.example

# Top-level documentation and scratch logs
/*.log
/*.md
/*.patch
/*.txt

# Operating System artifacts
.DS_Store
**/.DS_Store
Thumbs.db

# Explicit inclusion whitelist for required build assets
!src/**
!pom.xml
