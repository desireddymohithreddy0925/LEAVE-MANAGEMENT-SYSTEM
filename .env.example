# ==============================================================================
# Leave Management System - Production Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Configure strong, unique credentials for DB_PASSWORD and JWT_SECRET.
# Note: Production startup will fail if DB_PASSWORD or JWT_SECRET are missing or insecure.

# --- Database Credentials ---
DB_NAME=leave_management_db
DB_USERNAME=postgres
DB_PASSWORD=YourStrongDatabasePasswordHere2026!
DB_PORT=5432

# --- Application Server Configuration ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Security & JWT Authentication ---
# Must be at least 256 bits (32 bytes). Recommended: Base64-encoded 256-bit random key.
# Example generated via `openssl rand -base64 32`:
JWT_SECRET=c2VjdXJlUmFuZG9tSldUU2VjcmV0S2V5MjAyNkZvckxlYXZlTWFuYWdlbWVudFN5c3RlbSE=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
