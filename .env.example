# ==============================================================================
# Leave Management System - Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env to customize your deployment parameters:
#   cp .env.example .env

# --- Database Configuration ---
DB_NAME=leave_management_db
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_PORT=5432

# --- Application Service Configuration ---
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Security & JWT Authentication ---
# In production, replace with a 256-bit+ secure random secret
JWT_SECRET=defaultSecretKeyThatIsAtLeast32CharactersLongAndSecure!
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

