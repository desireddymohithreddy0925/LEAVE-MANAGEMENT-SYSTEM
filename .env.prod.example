# ==============================================================================
# Leave Management System - Hardened Production Environment (.env.prod)
# ==============================================================================
# NOTE: Replace placeholder values with strong, unique secrets before deployment.
# Production startup will intentionally fail if DB_PASSWORD, JWT_SECRET, or
# ENCRYPTION_KEY are missing, placeholder, or insecure default values.
# ==============================================================================
SPRING_PROFILES_ACTIVE=prod

APP_PORT=8080
SERVER_PORT=8080

DB_NAME=leave_management_db
DB_USERNAME=postgres
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DB_PASSWORD
DB_PORT=5432
DB_URL=jdbc:postgresql://db:5432/leave_management_db

DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_256_BIT_BASE64_SECRET_KEY_GENERATED_VIA_OPENSSL_RAND
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_256_BIT_SECRET_FOR_SENSITIVE_DATA_ENCRYPTION

# Configure specific upstream reverse proxy / load balancer IPs or tightly controlled subnets.
# Do NOT configure broad private RFC 1918 ranges (e.g., 10.0.0.0/8) by default to prevent internal spoofing.
# Example: 127.0.0.1,::1,10.0.1.15/32,192.168.1.100/32
SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
LOCKOUT_MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

